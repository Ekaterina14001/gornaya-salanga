# Copy to .env and adjust
DATABASE_URL=postgres://salanga:salanga@localhost:5432/gornaya_salanga?sslmode=disable
# На Windows используйте 127.0.0.1, не localhost (иначе IPv6 [::1] и Redis не найдётся)
REDIS_URL=redis://127.0.0.1:6379/0
# В production обязательно: REDIS_REQUIRED=true
REDIS_REQUIRED=false
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
PORT=8080
GIN_MODE=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
ADMIN_ORIGIN=http://localhost:5173
RATE_LIMIT_QR_VERIFY=10
RATE_LIMIT_QR_WINDOW=1m
# Auth brute-force protection (login, register, forgot-password, verify-phone, reset-password)
RATE_LIMIT_AUTH=20
RATE_LIMIT_AUTH_WINDOW=1m
OPENWEATHERMAP_API_KEY=
POS_API_KEY_SHELTER=dev-shelter-key
POS_API_KEY_BARS=dev-bars-key
POS_API_KEY_RKEEPER=dev-rkeeper-key
QR_TTL_SECONDS=60

# Production (GIN_MODE=release): run scripts/generate-secrets.ps1, set REDIS_REQUIRED=true,
# change POS keys, SMS_MODE=smsru, EMAIL_MODE=smtp. Server refuses weak dev defaults.
# Firebase Cloud Messaging — путь к JSON ключу сервисного аккаунта (Project settings -> Service accounts)
FCM_CREDENTIALS_FILE=

# SMS: log = код в лог backend (dev), smsru = реальная отправка через SMS.ru
SMS_MODE=log
SMS_RU_API_ID=
# Имя отправителя (согласованное в SMS.ru), необязательно
SMS_RU_FROM=
# Шаблон текста, {code} заменяется на код
SMS_MESSAGE_TEMPLATE=Код подтверждения Горная Саланга: {code}
# true = тестовый режим SMS.ru (SMS не отправляется, баланс не списывается)
SMS_RU_TEST=false

# Email: log = ссылки в лог backend, smtp = реальная почта
EMAIL_MODE=log
# Mail.ru (нужен пароль приложения: Настройки -> Безопасность -> Пароли для внешних приложений)
# EMAIL_MODE=smtp
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_TLS=ssl
# SMTP_USER=your@mail.ru
# SMTP_PASSWORD=
# SMTP_FROM=your@mail.ru
# SMTP_FROM_NAME=Gornaya Salanga
# APP_PUBLIC_URL=http://localhost:5173
