# Copy to .env and adjust
DATABASE_URL=postgres://salanga:salanga@localhost:5432/gornaya_salanga?sslmode=disable
# На Windows используйте 127.0.0.1, не localhost (иначе IPv6 [::1] и Redis не найдётся)
REDIS_URL=redis://127.0.0.1:6379/0
# В production обязательно: REDIS_REQUIRED=true
REDIS_REQUIRED=false
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
PORT=8080
GIN_MODE=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
ADMIN_ORIGIN=http://localhost:5173
RATE_LIMIT_QR_VERIFY=10
RATE_LIMIT_QR_WINDOW=1m
OPENWEATHERMAP_API_KEY=
POS_API_KEY_SHELTER=dev-shelter-key
POS_API_KEY_BARS=dev-bars-key
POS_API_KEY_RKEEPER=dev-rkeeper-key
QR_TTL_SECONDS=60
# Firebase Cloud Messaging — путь к JSON ключу сервисного аккаунта (Project settings -> Service accounts)
FCM_CREDENTIALS_FILE=
