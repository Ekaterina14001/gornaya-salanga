# Shared environment template for Gornaya Salanga monorepo
# Copy to backend/.env and adjust as needed

# Database
DATABASE_URL=postgres://salanga:salanga@localhost:5432/gornaya_salanga?sslmode=disable

# Redis (на Windows — 127.0.0.1, не localhost: иначе IPv6 [::1])
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Server
PORT=8080
GIN_MODE=debug

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Admin panel origin
ADMIN_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_QR_VERIFY=10
RATE_LIMIT_QR_WINDOW=1m

# OpenWeatherMap (Phase 2+)
OPENWEATHERMAP_API_KEY=

# Firebase (Phase 2+)
FIREBASE_CREDENTIALS_PATH=

# POS API keys (dev defaults)
POS_API_KEY_SHELTER=dev-shelter-key
POS_API_KEY_BARS=dev-bars-key
POS_API_KEY_RKEEPER=dev-rkeeper-key

# QR settings
QR_TTL_SECONDS=60
