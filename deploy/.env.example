# Demo / staging VPS — copy to deploy/.env and edit before: docker compose up -d --build
#
# Production salanga.ru: run prepare-salanga-env.ps1, set SMS/SMTP secrets, then upload-salanga.ps1

# Public host (admin domain for salanga.ru, or IP for demo)
PUBLIC_HOST=203.0.113.10
PUBLIC_API_URL=http://203.0.113.10

# Demo: publish on all interfaces. Production behind host nginx: 127.0.0.1 + ports below
API_BIND_HOST=0.0.0.0
API_PUBLISH_PORT=8080
ADMIN_BIND_HOST=0.0.0.0
ADMIN_PUBLISH_PORT=80

POSTGRES_USER=salanga
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=gornaya_salanga

# Used by migrate + api containers (host = postgres service name)
DATABASE_URL=postgres://salanga:change-this-postgres-password@postgres:5432/gornaya_salanga?sslmode=disable
REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=true

# Generate: openssl rand -hex 32
JWT_SECRET=change-this-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

PORT=8080
GIN_MODE=release

# Admin origin + API for CORS (comma-separated)
CORS_ORIGINS=http://203.0.113.10,http://203.0.113.10:80,http://203.0.113.10:8080
ADMIN_ORIGIN=http://203.0.113.10

RATE_LIMIT_QR_VERIFY=10
RATE_LIMIT_QR_WINDOW=1m
RATE_LIMIT_AUTH=20
RATE_LIMIT_AUTH_WINDOW=1m
QR_TTL_SECONDS=60

OPENWEATHERMAP_API_KEY=
FCM_CREDENTIALS_FILE=/app/secrets/fcm-service-account.json

# SMS.ru — см. backend/.env.example
SMS_MODE=log
SMS_RU_API_ID=
SMS_RU_FROM=
SMS_MESSAGE_TEMPLATE=Код подтверждения Горная Саланга: {code}
SMS_RU_TEST=false

EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Gornaya Salanga
APP_PUBLIC_URL=http://localhost:5173

POS_API_KEY_SHELTER=dev-shelter-key
POS_API_KEY_BARS=dev-bars-key
POS_API_KEY_RKEEPER=dev-rkeeper-key
