<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash: прозрачный круглый знак без «подложки-квадрата». -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="288dp"
        android:height="288dp"
        android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_brand" />
    </item>
</layer-list>
